{
  "name": "mitm-antigravity",
  "version": "2.0.2",
  "private": true,
  "description": "Cross-platform Antigravity MITM app with configurable DNS, endpoint, API key and model mapping",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mitm-antigravity": "index.js"
  },
  "scripts": {
    "start": "node index.js start",
    "status": "node index.js status",
    "stop": "node index.js stop",
    "test": "node --test",
    "check": "node scripts/check-js.js",
    "build:pkg": "node scripts/build-pkg.js native && node scripts/copy-settings.js",
    "build:pkg:native": "node scripts/build-pkg.js native && node scripts/copy-settings.js",
    "build:pkg:macos": "node scripts/build-pkg.js macos && node scripts/copy-settings.js",
    "build:pkg:macos:all": "node scripts/build-pkg.js macos-all && node scripts/copy-settings.js",
    "build:pkg:macos:arm64": "node scripts/build-pkg.js macos-arm64 && node scripts/copy-settings.js",
    "build:pkg:macos:x64": "node scripts/build-pkg.js macos-x64 && node scripts/copy-settings.js",
    "build:pkg:windows": "node scripts/build-pkg.js windows && node scripts/copy-settings.js",
    "build:pkg:windows:x64": "node scripts/build-pkg.js win-x64 && node scripts/copy-settings.js",
    "build:pkg:windows:arm64": "node scripts/build-pkg.js win-arm64 && node scripts/copy-settings.js",
    "build:pkg:linux": "node scripts/build-pkg.js linux && node scripts/copy-settings.js",
    "build:pkg:all": "node scripts/build-pkg.js all && node scripts/copy-settings.js",
    "build": "pnpm run tauri:build:native",
    "tauri:prepare": "node scripts/prepare-tauri.js",
    "tauri:prepare:dev": "pnpm run build:pkg:native && node scripts/prepare-tauri.js",
    "tauri:dev": "pnpm exec tauri dev",
    "tauri:build:native": "pnpm run build:pkg:native && pnpm exec tauri build",
    "tauri:build:macos": "pnpm run build:pkg:macos && pnpm exec tauri build",
    "tauri:build:macos:all": "pnpm run build:pkg:macos:all && pnpm exec tauri build --target universal-apple-darwin",
    "tauri:build:windows": "node scripts/tauri-build-windows.js",
    "tauri:build:windows:bootstrapper": "node scripts/tauri-build-windows.js --flavor bootstrapper",
    "tauri:build:windows:offline": "node scripts/tauri-build-windows.js --flavor offline",
    "tauri:build": "pnpm run tauri:build:native",
    "restart": "bash scripts/restart-proxy.sh",
    "proxy:restart": "bash scripts/restart-proxy.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@yao-pkg/pkg": "^6.14.2"
  },
  "pkg": {
    "scripts": [
      "index.js",
      "src/index.js",
      "src/cli/*.js",
      "src/config/*.js",
      "src/cert/*.js",
      "src/dns/*.js",
      "src/proxy/*.js",
      "src/models/*.js",
      "src/system/*.js",
      "src/gui/*.js"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "node-forge": "^1.4.0"
  }
}
