{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MITM AG",
    "version": "0.2.0",
    "identifier": "io.phongdang.mitm-antigravity",
    "build": {
        "beforeBuildCommand": "npm run tauri:prepare",
        "beforeDevCommand": "npm run tauri:prepare:dev",
        "devUrl": "http://127.0.0.1:20245/",
        "frontendDist": "../tauri-ui"
    },
    "app": {
        "windows": [
            {
                "title": "MITM AG",
                "width": 1180,
                "height": 820,
                "minWidth": 980,
                "minHeight": 680,
                "url": "index.html"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app"
        ],
        "resources": [
            "resources/mitm-ag-backend*",
            "resources/settings.json"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "macOS": {
            "minimumSystemVersion": "10.13"
        }
    }
}