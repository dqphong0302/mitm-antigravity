{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MITM AG",
    "version": "0.2.3",
    "identifier": "io.phongdang.mitm-antigravity",
    "build": {
        "beforeBuildCommand": "npm run tauri:prepare",
        "beforeDevCommand": "npm run tauri:prepare:dev",
        "devUrl": "http://127.0.0.1:20245/",
        "frontendDist": "../tauri-ui"
    },
    "app": {
        "windows": [
            {
                "title": "MITM AG",
                "width": 1180,
                "height": 820,
                "minWidth": 980,
                "minHeight": 680,
                "url": "index.html"
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src http://127.0.0.1:20245; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5QUQ2M0ZEQjFEMEEwMjMKUldRam9OQ3gvV090MmF5aXd3eXJoY1g5M0Ird293bDJZOU5lVGJuVWUxMHcwL2YrWEw1dURwa28K",
            "endpoints": [
                "https://github.com/dqphong0302/mitm-antigravity/releases/latest/download/latest.json"
            ],
            "dialog": true,
            "installMode": "basicInstallMode"
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "app"
        ],
        "resources": [
            "resources"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "macOS": {
            "minimumSystemVersion": "10.13"
        },
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            },
            "certificateThumbprint": null,
            "digestAlgorithm": "sha256",
            "timestampUrl": ""
        }
    }
}
